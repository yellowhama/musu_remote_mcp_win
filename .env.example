# Absolute host path mounted at /workspace. Create code/ and wiki/ inside it,
# or change MCP_EDITABLE_ROOTS to match your subdirectories.
WORKSPACE_HOST_PATH=D:/dev/remote-workspace
BACKUP_HOST_PATH=D:/dev/remote-dev-mcp-backups

MCP_EDITABLE_ROOTS=/workspace/code,/workspace/wiki
MCP_DEFAULT_CWD=/workspace/code
MCP_LOCAL_PORT=39391
MCP_PREVIEW_PORT=39392
MCP_MEMORY_LIMIT=1536m
MCP_CPU_LIMIT=2
TZ=UTC
